_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# Azure Functions
local.settings.json

# Rider
.idea/

# Mac
.DS_Store
